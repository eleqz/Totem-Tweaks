  "authors": [
    "Pathdos"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/cpvp",
    "issues": "https://github.com/eleqz/Totem-Tweaks/issues",
    "sources": "https://github.com/eleqz/Totem-Tweaks"
  },
  "license": "ARR",
  "icon": "assets/totemtweaks/icon.png",
